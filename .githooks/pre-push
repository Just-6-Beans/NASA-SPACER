#!/bin/sh
# SPACER pre-push hook. `npm ci` turns it on (git config core.hooksPath .githooks).
# Only pushes to main are checked. It stops a push that would:
#   - delete main, or overwrite commits a teammate already pushed (force push);
#   - change files another lane owns without naming them (scripts/lane-check.mjs);
#   - fail `npm run check`.
# Emergency bypass: git push --no-verify. CI still runs the same checks afterwards.
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  if [ "$local_sha" = "$zero" ]; then
    echo "pre-push: refusing to delete main." >&2; exit 1
  fi
  if [ "$remote_sha" != "$zero" ]; then
    if ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
      echo "pre-push: main has commits you have not fetched. Run: git pull --rebase origin main" >&2; exit 1
    fi
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
      echo "pre-push: this push would overwrite commits a teammate put on main. Never force-push main." >&2
      echo "          Run: git pull --rebase origin main, then push again." >&2
      exit 1
    fi
    base="$remote_sha"
  else
    base="origin/main"
  fi
  branch=$(git rev-parse --abbrev-ref HEAD)
  node scripts/lane-check.mjs --branch "$branch" --base "$base" --head "$local_sha" </dev/null || status=1
  [ $status -eq 0 ] || break
  echo "pre-push: running npm run check before main changes..."
  npm run check --silent </dev/null || { echo "pre-push: npm run check failed, so main was not changed." >&2; status=1; }
done
exit $status
